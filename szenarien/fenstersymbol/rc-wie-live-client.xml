  <desktops number="4" popupTime="0" prefix="Arbeitsfläche" />
  <keyboard><default /></keyboard>
  <theme><name>Querencia-Klassisch</name><icon>gnome-human</icon></theme>
  <windowRules>
    <windowRule identifier="org.querencia.Einstellungen" iconPriority="client" />
    <windowRule identifier="querencia-einstellungen" iconPriority="client" />
  </windowRules>
</labwc_config>
