# Build
/target/

# Werkzeug-Builds (neu erzeugbar mit werkzeug/bauen-werkzeug.sh)
/werkzeug/bin/

# Vorlagen-Binaries der Integrationsskripte: Artefakte, Prüfsummen stehen in
# den Skripten und in nachweis/*SHA256SUMS; nicht ins Repo.
/integration/**/querencia-einstellungen

# Nachweise: Läufe, Profile, Bilder und Binaries bleiben lokal.
# Ins Repo kommen nur die Testbilder (isoliert.sh braucht sie) und die
# kleinen Textergebnisse direkt in nachweis/ (TSV, Prüfsummen, Protokolle).
/nachweis/*
!/nachweis/testbilder/
!/nachweis/*.tsv
!/nachweis/*SHA256SUMS
!/nachweis/*.txt
!/nachweis/*.log
# G2-X: Textnachweise unter nachweis/g2x/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2x/
/nachweis/g2x/**/*.png
/nachweis/g2x/**/querencia-einstellungen
/nachweis/g2x/laeufe/
# G2-Z: wie G2-X – Textnachweise unter nachweis/g2z/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2z/
/nachweis/g2z/**/*.png
/nachweis/g2z/**/querencia-einstellungen
/nachweis/g2z/gui-kette.fertig
# G2-AA: wie G2-Z – Textnachweise unter nachweis/g2aa/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2aa/
/nachweis/g2aa/**/*.png
/nachweis/g2aa/**/querencia-einstellungen
# G2-AF: wie G2-Z – Textnachweise unter nachweis/g2af/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2af/
/nachweis/g2af/**/*.png
/nachweis/g2af/**/querencia-einstellungen
# G2-AG: wie G2-AA – Textnachweise unter nachweis/g2ag/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2ag/
/nachweis/g2ag/**/*.png
/nachweis/g2ag/**/querencia-einstellungen
# G2-AJ: wie G2-AG – Textnachweise unter nachweis/g2aj/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2aj/
/nachweis/g2aj/**/*.png
/nachweis/g2aj/**/querencia-einstellungen
# Einstellungen 0.1.0: wie G2-AJ – Textnachweise unter nachweis/010/ ins Repo,
# Binaries, Kataloge, Bilder und Läufe nicht; Kataloge der Vorlage wie die Binary
!/nachweis/010/
/nachweis/010/**/*.png
/nachweis/010/**/querencia-einstellungen
/nachweis/010/**/*.mo
/integration/**/*.mo
# Python-Bytecode der Werkzeuge (010-deutsch-gleich.py importiert i18n.py)
__pycache__/
# Einstellungen 0.1.1: wie 0.1.0 – Textnachweise unter nachweis/011/ ins Repo,
# Binaries, Kataloge, Bilder und Läufe nicht
!/nachweis/011/
/nachweis/011/**/*.png
/nachweis/011/**/querencia-einstellungen
/nachweis/011/**/*.mo
# Einstellungen 0.1.2: wie 0.1.1 – Textnachweise unter nachweis/012/ ins Repo,
# Binaries, Kataloge, Bilder und Läufe nicht
!/nachweis/012/
/nachweis/012/**/*.png
/nachweis/012/**/querencia-einstellungen
/nachweis/012/**/*.mo
# Einstellungen 0.1.3: wie 0.1.2 – Textnachweise unter nachweis/013/ ins Repo,
# Binaries, Kataloge, Bilder und Läufe nicht
!/nachweis/013/
/nachweis/013/**/*.png
/nachweis/013/**/querencia-einstellungen
/nachweis/013/**/*.mo
