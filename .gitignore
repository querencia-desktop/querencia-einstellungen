# Build
/target/

# Werkzeug-Builds (neu erzeugbar mit werkzeug/bauen-werkzeug.sh)
/werkzeug/bin/

# Vorlagen-Binaries der Integrationsskripte: Artefakte, Prüfsummen stehen in
# den Skripten und in nachweis/*SHA256SUMS; nicht ins Repo.
/integration/**/querencia-einstellungen

# Nachweise: Läufe, Profile, Bilder und Binaries bleiben lokal.
# Ins Repo kommen nur die Testbilder (isoliert.sh braucht sie) und die
# kleinen Textergebnisse direkt in nachweis/ (TSV, Prüfsummen, Protokolle).
/nachweis/*
!/nachweis/testbilder/
!/nachweis/*.tsv
!/nachweis/*SHA256SUMS
!/nachweis/*.txt
!/nachweis/*.log
# G2-X: Textnachweise unter nachweis/g2x/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2x/
/nachweis/g2x/**/*.png
/nachweis/g2x/**/querencia-einstellungen
/nachweis/g2x/laeufe/
# G2-Z: wie G2-X – Textnachweise unter nachweis/g2z/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2z/
/nachweis/g2z/**/*.png
/nachweis/g2z/**/querencia-einstellungen
/nachweis/g2z/gui-kette.fertig
# G2-AA: wie G2-Z – Textnachweise unter nachweis/g2aa/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2aa/
/nachweis/g2aa/**/*.png
/nachweis/g2aa/**/querencia-einstellungen
# G2-AF: wie G2-Z – Textnachweise unter nachweis/g2af/ ins Repo, Binaries/Bilder/Läufe nicht
!/nachweis/g2af/
/nachweis/g2af/**/*.png
/nachweis/g2af/**/querencia-einstellungen
